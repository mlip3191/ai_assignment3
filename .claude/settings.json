{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh api user *)",
      "Bash(pytest *)",
      "Bash(pytest)",
      "Bash(python -m pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format --check *)",
      "Bash(python scripts/scan_secrets.py *)",
      "Bash(python scripts/scan_secrets.py)",
      "Bash(python scripts/check_models.py)",
      "Bash(python scripts/check_config.py)",
      "Bash(python scripts/check_endpoints.py)",
      "Bash(python scripts/doctor.py)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./runtime/uploads/**)",
      "Edit(./scripts/model_policy.json)",
      "Edit(./.githooks/**)",
      "Edit(./scripts/prepush.py)",
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run_py.sh\" session_start.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run_py.sh\" pre_bash_guard.py fail-closed"
          }
        ]
      }
    ]
  }
}
