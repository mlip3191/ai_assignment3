  "banned_code_patterns": {
    "\\bgr(?:adio)?\\.load\\s*\\(": "Gradio's gr.load pulls models or Spaces from Hugging Face",
    "\\bspeechSynthesis\\b": "browser text-to-speech is a different speech model; DJ speech must come from Chatterbox",
    "\\bSpeechSynthesisUtterance\\b": "browser text-to-speech is a different speech model; DJ speech must come from Chatterbox",
    "\\bwebkitSpeech\\w*": "browser speech APIs are a different model",
    "\\bpipeline\\s*\\(\\s*['\\\"]": "transformers-style local model pipelines are not allowed"
  },
  "_comment_patterns": "banned_code_patterns keys are Python regular expressions."
