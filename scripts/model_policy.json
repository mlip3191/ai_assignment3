{
  "_comment": "Single source of truth for which AI models the app may use. Read by scripts/check_models.py (CI, /check) and .claude/hooks/pre_bash_guard.py. PROJECT.md section 7.0 mirrors this file. Change only by PR with the whole team's approval.",
  "services": {
    "qwen": {
      "model": "Qwen3.6-35B-A3B",
      "port": 9001,
      "purpose": "All text: song titles, lyrics, cover-art prompts, DJ commentary scripts",
      "env_url": "QWEN_BASE_URL",
      "env_model": "QWEN_MODEL",
      "client": "jukebox/clients/qwen.py"
    },
    "flux": {
      "model": "FLUX.2 klein 4B",
      "port": 9006,
      "purpose": "Cover art images (every generated song, and the 3 samples)",
      "env_url": "FLUX_BASE_URL",
      "env_model": "FLUX_MODEL",
      "client": "jukebox/clients/flux.py"
    },
    "acestep": {
      "model": "ACE-Step 1.5 XL Turbo",
      "port": 9007,
      "purpose": "Music audio (instrumental and vocal tracks, and the 3 samples)",
      "env_url": "ACESTEP_BASE_URL",
      "env_model": "ACESTEP_MODEL",
      "client": "jukebox/clients/acestep.py"
    },
    "chatterbox": {
      "model": "Chatterbox Multilingual V3",
      "port": 9008,
      "purpose": "DJ speech audio (default voice or uploaded MP3/WAV reference)",
      "env_url": "CHATTERBOX_BASE_URL",
      "env_model": "CHATTERBOX_MODEL",
      "client": "jukebox/clients/chatterbox.py"
    }
  },
  "forbidden_ports": [
    9000
  ],
  "app_port": 7860,
  "service_aliases": {
    "qwen": [
      "qwen"
    ],
    "flux": [
      "flux"
    ],
    "acestep": [
      "acestep",
      "ace_step",
      "ace-step"
    ],
    "chatterbox": [
      "chatterbox"
    ]
  },
  "feature_clients": {
    "_comment": "Which clients each feature module may import. Anything not listed may import no clients at all.",
    "jukebox/services/songs.py": [
      "qwen",
      "acestep"
    ],
    "jukebox/services/art.py": [
      "qwen",
      "flux"
    ],
    "jukebox/services/dj.py": [
      "qwen",
